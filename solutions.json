                }
            ]
        },
        "no2": {
            "title": "จงหาผลเฉลยของสมการอนุพันธ์ DE โดยใช้ผลการแปลงลาปลาซตามขั้นตอนต่อไปนี้",
            "equation": "y'' + 4y' + 3y = -16e^t",
            "initial_conditions": [
                "y(0) = 1",
                "y'(0) = -13"
            ],
            "steps": [
                {
                    "label": "2.1 หาผลการแปลงลาปลาซของสมการเชิงอนุพันธ์",
                    "equations": [
                        "\\mathcal{L}\\{y''\\} + 4\\mathcal{L}\\{y'\\} + 3\\mathcal{L}\\{y\\} = \\mathcal{L}\\{-16e^t\\}",
                        "\\mathcal{L}\\{y''\\} + 4\\mathcal{L}\\{y'\\} + 3\\mathcal{L}\\{y\\} = -\\frac{16}{(s - 1)}"
                    ]
                },
                {
                    "label": "2.2 แทนค่าความสัมพันธ์  <span class='text-red'>\\(\\mathcal{L}\\{y'\\} = s\\mathcal{L}\\{y\\} - y(0)\\) และ \\(\\mathcal{L}\\{y''\\} = s^2\\mathcal{L}\\{y\\} - sy(0) - y'(0)\\)</span>",
                    "equations": [
                        "\\mathcal{L}\\{y''\\} + 4\\mathcal{L}\\{y'\\} + 3\\mathcal{L}\\{y\\} = -\\frac{16}{(s - 1)}",
                        "[s^2\\mathcal{L}\\{y\\} - sy(0) - y'(0)] + 4[s\\mathcal{L}\\{y\\} - y(0)] + 3\\mathcal{L}\\{y\\} = -\\frac{16}{(s - 1)}"
                    ]
                },
                {
                    "label": "2.3 แทนค่า y(0) และ y'(0) จากเงื่อนไขเริ่มต้น",
                    "equations": [
                        "[s^2\\mathcal{L}\\{y\\} - s(1) - (-13)] + 4[s\\mathcal{L}\\{y\\} - (1)] + 3\\mathcal{L}\\{y\\} = -\\frac{16}{(s - 1)}",
                        "s^2\\mathcal{L}\\{y\\} - s +13 + 4s\\mathcal{L}\\{y\\} - 4 + 3\\mathcal{L}\\{y\\} = -\\frac{16}{(s - 1)}",
                        "(s^2+4s+3)\\mathcal{L}\\{y\\} -s +9 = -\\frac{16}{(s - 1)}",
                        "(s^2 + 4s + 3)\\mathcal{L}\\{y\\} = -\\frac{16}{(s - 1)} + s - 9 = \\frac{-16 + s^2 - s - 9s + 9}{(s - 1)}",
                        "(s^2 +4s + 3)\\mathcal{L}\\{y\\} = \\frac{s^2 - 10s - 7}{(s - 1)}"
                    ]
                },
                {
                    "label": "2.4 จัดรูปสมการให้อยู่ในรูป L{y}=F(s)",
                    "equations": [
                        "\\mathcal{L}\\{y\\} = \\frac{s^2 - 10s - 7}{(s - 1)(s^2 + 4s + 3)}"
                    ]
                },
                {
                    "label": "แยกเศษส่วนย่อย <span style='color: red; font-weight: bold;'>กด expand() ใช้เครื่องคิดเลข</span>",
