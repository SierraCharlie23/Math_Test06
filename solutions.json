      "original": "F(s) = \\frac{5s^2 + 14s - 92}{(s - 8)(s^2 + 4)}",
      "steps": [
        {
          "label": "1.1 Partial Fraction",
          "equations": [
            "F(s) = \\frac{5}{s - 8} + \\frac{14}{s^2 + 4}"
          ]
        },
        {
          "label": "1.2 Inverse Laplace",
          "equations": [
            "f(t) = \\mathcal{L}^{-1}\\left\\{\\frac{5}{s - 8}\\right\\} + \\mathcal{L}^{-1}\\left\\{\\frac{14}{s^2 + 4}\\right\\}",
            "f(t) = 5e^{8t} + 7\\sin(2t)"
          ]
        },
        {
          "label": "Final f(t)",
          "equations": [
            "f(t) = 5e^{8t} + 7\\sin(2t)"
          ]
        }
