        "no2": {
            "title": "จงหาผลเฉลยของสมการอนุพันธ์ DE โดยใช้ผลการแปลงลาปลาซตามขั้นตอนต่อไปนี้",
            "equation": "y'' - y' - 2y = 4",
            "initial_conditions": [
                "y(0) = 0",
                "y'(0) = -5"
            ],
            "steps": [
                {
                    "label": "2.1 หาผลการแปลงลาปลาซของสมการเชิงอนุพันธ์",
                    "equations": [
                        "\\mathcal{L}\\{y''\\} - \\mathcal{L}\\{y'\\} - 2\\mathcal{L}\\{y\\} = \\mathcal{L}\\{4\\}",
                        "\\mathcal{L}\\{y''\\} - \\mathcal{L}\\{y'\\} - 2\\mathcal{L}\\{y\\} = \\frac{4}{s}"
                    ]
                },
                {
                    "label": "2.2 แทนค่าความสัมพันธ์ <span class='text-red'>\\(\\mathcal{L}\\{y'\\} = s\\mathcal{L}\\{y\\} - y(0)\\) และ \\(\\mathcal{L}\\{y''\\} = s^2\\mathcal{L}\\{y\\} - sy(0) - y'(0)\\)</span>",
                    "equations": [
                        "[s^2\\mathcal{L}\\{y\\} - sy(0) - y'(0)] - [s\\mathcal{L}\\{y\\} - y(0)] - 2\\mathcal{L}\\{y\\} = \\frac{4}{s}"
                    ]
                },
                {
                    "label": "2.3 แทนค่า y(0) และ y'(0) จากเงื่อนไขเริ่มต้น",
                    "equations": [
                        "[s^2\\mathcal{L}\\{y\\} - s(0) - (-5)] - [s\\mathcal{L}\\{y\\} - 0] - 2\\mathcal{L}\\{y\\} = \\frac{4}{s}",
                        "(s^2 - s - 2)\\mathcal{L}\\{y\\} + 5 = \\frac{4}{s}",
                        "(s^2 - s - 2)\\mathcal{L}\\{y\\} = \\frac{4}{s} - 5 = \\frac{4 - 5s}{s}"
                    ]
                },
                {
                    "label": "2.4 จัดรูปสมการให้อยู่ในรูป L{y}=F(s)",
                    "equations": [
                        "\\mathcal{L}\\{y\\} = \\frac{4 - 5s}{(s)(s^2 - s - 2)}"
                    ]
                },
                {
                    "label": "แยกเศษส่วนย่อย <span style='color: red; font-weight: bold;'>กด expand() ใช้เครื่องคิดเลข</span>",
                    "equations": [
                        "\\mathcal{L}\\{y\\} = -\\frac{2}{s} + \\frac{3}{(s + 1)} - \\frac{1}{(s - 2)}"
                    ]
                },
                {
                    "label": "2.5 หาผลเฉลย y จาก \\(\\mathcal{L}^{-1}\\{F(s)\\}\\)",
                    "equations": [
                        "y(t) = -2\\mathcal{L}^{-1}\\left\\{\\frac{1}{s}\\right\\} + 3\\mathcal{L}^{-1}\\left\\{\\frac{1}{(s + 1)}\\right\\} - \\mathcal{L}^{-1}\\left\\{\\frac{1}{(s - 2)}\\right\\}"
                    ]
                },
                {
                    "label": "ตอบ",
                    "equations": [
                        "y(t) = -2 + 3e^{-t} - e^{2t}"
                    ]
                }
            ]
        }
