            "title": "จงหาผลการแปลงลาปลาซผกผันของ F(s) ที่กำหนดโดยใช้เศษส่วนย่อย ตามขั้นตอนต่อไปนี้",
            "original": "F(s) = \\frac{8s^2 - 84s + 96}{s^3 - 8s^2 + 12s}",
            "steps": [
                {
                    "label": "1.1 เขียน F(s) เศษส่วนย่อย <span class='text-red'>กด expand() ใช้เครื่องคิดเลข</span>",
                    "equations": [
                        "F(s) = \\frac{8}{s} + \\frac{5}{(s - 2)} - \\frac{5}{(s - 6)}"
                    ]
                },
                {
                    "label": "1.2 หาผลการแปลงลาปลาซของเศษส่วนย่อยในข้อ 1.1",
                    "equations": [
                        "f(t) = \\mathcal{L}^{-1}\\left\\{\\frac{8}{s}\\right\\} + \\mathcal{L}^{-1}\\left\\{\\frac{5}{(s - 2)}\\right\\} - \\mathcal{L}^{-1}\\left\\{\\frac{5}{(s - 6)}\\right\\}",
                        "f(t) = 8\\mathcal{L}^{-1}\\left\\{\\frac{1}{s}\\right\\} + 5\\mathcal{L}^{-1}\\left\\{\\frac{1}{(s - 2)}\\right\\} - 5\\mathcal{L}^{-1}\\left\\{\\frac{1}{(s - 6)}\\right\\}",
                        "f(t) = 8 + 5e^{2t} - 5e^{6t}"
                    ]
                },
                {
                    "label": "ตอบ",
                    "equations": [
                        "f(t) = 8 + 5e^{2t} - 5e^{6t}"
                    ]
                }
            ]
        },
        "no2": {
            "title": "จงหาผลเฉลยของสมการอนุพันธ์ DE โดยใช้ผลการแปลงลาปลาซตามขั้นตอนต่อไปนี้",
            "equation": "y'' + 4y = 4",
            "initial_conditions": [
                "y(0) = 8",
                "y'(0) = -2"
            ],
            "steps": [
                {
                    "label": "2.1 หาผลการแปลงลาปลาซของสมการเชิงอนุพันธ์",
                    "equations": [
                        "\\mathcal{L}\\{y''\\} + 4\\mathcal{L}\\{y\\} = \\mathcal{L}\\{4\\}",
                        "\\mathcal{L}\\{y''\\} + 4\\mathcal{L}\\{y\\} = \\frac{4}{s}"
                    ]
                },
                {
                    "label": "2.2 แทนค่าความสัมพันธ์ <span class='text-red'>\\(\\mathcal{L}\\{y'\\} = s\\mathcal{L}\\{y\\} - y(0)\\) และ \\(\\mathcal{L}\\{y''\\} = s^2\\mathcal{L}\\{y\\} - sy(0) - y'(0)\\)</span>",
                    "equations": [
                        "[s^2\\mathcal{L}\\{y\\} - sy(0) - y'(0)] + 4\\mathcal{L}\\{y\\} = \\frac{4}{s}"
                    ]
                },
                {
                    "label": "2.3 แทนค่า y(0) และ y'(0) จากเงื่อนไขเริ่มต้น",
                    "equations": [
                        "[s^2\\mathcal{L}\\{y\\} - s(8) - (-2)] + 4\\mathcal{L}\\{y\\} = \\frac{4}{s}",
                        "s^2\\mathcal{L}\\{y\\} - 8s + 2 + 4\\mathcal{L}\\{y\\} = \\frac{4}{s}",
                        "(s^2 + 4)\\mathcal{L}\\{y\\} - 8s + 2 = \\frac{4}{s}",
                        "(s^2 + 4)\\mathcal{L}\\{y\\} = \\frac{4}{s} + 8s - 2 = \\frac{4 + 8s^2 - 2s}{s}",
                        "(s^2 + 4)\\mathcal{L}\\{y\\} = \\frac{8s^2 - 2s + 4}{s}"
                    ]
                },
                {
                    "label": "2.4 จัดรูปสมการให้อยู่ในรูป L{y}=F(s)",
                    "equations": [
                        "\\mathcal{L}\\{y\\} = \\frac{8s^2 - 2s + 4}{(s)(s^2 + 4)}"
                    ]
                },
                {
                    "label": "แยกเศษส่วนย่อย <span style='color: red; font-weight: bold;'>กด expand() ใช้เครื่องคิดเลข</span>",
                    "equations": [
                        "\\mathcal{L}\\{y\\} = \\frac{1}{s} + \\frac{7s}{(s^2 + 4)} - \\frac{2}{(s^2 + 4)}"
                    ]
                },
                {
                    "label": "2.5 หาผลเฉลย y จาก \\(\\mathcal{L}^{-1}\\{F(s)\\}\\)",
                    "equations": [
                        "y(t) = \\mathcal{L}^{-1}\\left\\{\\frac{1}{s}\\right\\} + 7\\mathcal{L}^{-1}\\left\\{\\frac{s}{s^2 + 2^2}\\right\\} - \\mathcal{L}^{-1}\\left\\{\\frac{2}{s^2 + 2^2}\\right\\}"
                    ]
                },
                {
                    "label": "ตอบ",
                    "equations": [
                        "y(t) = 1 + 7\\cos(2t) - \\sin(2t)"
                    ]
                }
            ]
        }
    }
]